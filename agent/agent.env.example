# Copy this file to "agent.env" in the same folder and fill in the values.
# Keep agent.env on this machine only — it holds your Betfair login.

# From your Betfair account (the delayed application key)
BETFAIR_API_KEY=

# Your Betfair login. These never leave this computer.
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# Where to send the prices (given to you with the setup instructions)
INGEST_URL=https://2026greyhounds-production.up.railway.app/api/admin/odds-ingest
INGEST_TOKEN=
