# Database (stored in /app/data/ which should be a Railway persistent volume)
DATABASE_URL=sqlite:///./data/greyhound.db

# CORS - add your frontend URL
CORS_ORIGINS=["http://localhost:5173","https://your-app.vercel.app"]

# Betfair API (get from https://developer.betfair.com/)
# See docs/BETFAIR_SETUP.md for the activation checklist.
BETFAIR_API_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# Optional: certificate login (required if the account has 2FA enabled).
# Paths to a client certificate/key pair registered with Betfair.
BETFAIR_CERT_FILE=
BETFAIR_CERT_KEY_FILE=

# Model artifacts directory
MODEL_ARTIFACTS_DIR=./artifacts/models
