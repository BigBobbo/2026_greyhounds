# Database (stored in /app/data/ which should be a Railway persistent volume)
DATABASE_URL=sqlite:///./data/greyhound.db

# CORS - add your frontend URL
CORS_ORIGINS=["http://localhost:5173","https://your-app.vercel.app"]

# Auth: required header X-API-Key for every /api route except /api/health.
# Generate a long random value (e.g. `openssl rand -hex 32`). Leave empty to
# disable auth for local development only.
API_KEY=

# Model artifacts directory. Keep this under ./data/ so trained models live on
# the persistent volume — anything outside it is lost on redeploy.
MODEL_ARTIFACTS_DIR=./data/models

# Scraping politeness (seconds between requests)
SCRAPE_DELAY=2.0

# Nightly off-site backups (S3-compatible: Cloudflare R2 / Backblaze B2 / S3).
# All four must be set or the nightly backup job logs a warning and skips.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
